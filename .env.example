# Set environment variables in your shell or hosting provider. This file is not loaded automatically.
# Leave disabled until the database and at least one provider are configured.
AUTH_ENABLED=false
PUBLIC_ORIGIN=https://masterqueue.kazu107.xyz
DATABASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Heroku only: its router supplies the trusted final forwarding hop.
TRUST_PROXY=1
# Optional trusted PostgreSQL CA certificate, PEM encoded as base64. TLS verification stays enabled.
AUTH_DATABASE_CA_BASE64=
# Comma-separated immutable account usernames or UUIDs; empty means no Web developer access.
DEVELOPER_USERNAMES=
DEVELOPER_USER_IDS=
RANKED_VERIFIER_ENABLED=false
# Optional local native Godot executable; Heroku installs its verified Linux runtime automatically.
GODOT_VERIFIER_PATH=
