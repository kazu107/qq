# Godot 4+ specific ignores
.godot/
/android/
.DS_Store
Thumbs.db
*.tmp
*.bak
*.blend1
__pycache__/
*.pyc
node_modules/

# EOS local credentials and proprietary redistributables.
/config/eos_credentials.local.cfg
/addons/gd-eos/bin/windows/EOSSDK-Win64-Shipping.dll
/addons/gd-eos/bin/windows/x64/xaudio2_9redist.dll
/tools/.local/
/sfx_generation.pid
/sfx_regenerate.stdout.log
/sfx_regenerate.stderr.log
/sfx_generation.stdout.log
/sfx_generation.stderr.log
/build/*
!/build/.gdignore
!/build/web/
!/build/web/**
/build/web/index.pck
